# Contoh pengaturan untuk mencoba LokerLens dengan Docker di LAPTOP. Panduan: docs/deploy.md.
#
# Cara pakai: salin file ini menjadi ".env" di root repo (sejajar docker-compose.yml), lalu isi nilainya.
# File .env itu dibaca otomatis oleh "docker compose" dan TIDAK ikut di-commit.
# Untuk server (Coolify) jangan pakai file ini, lihat web/.env.production.example.

# Buat dari folder web/:  php artisan key:generate --show   (salin hasilnya, diawali base64:)
APP_KEY=

# Alamat aplikasi di laptop
APP_URL=http://localhost:8080

# Kata sandi database MySQL di container. Bebas, cukup untuk laptop (jangan dipakai di server).
DB_PASSWORD=
DB_ROOT_PASSWORD=
