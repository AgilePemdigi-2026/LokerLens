# Konfigurasi khusus test BDD (Behat). Dipakai saat APP_ENV=behat.
# Cara pakai (dari web/):
#   copy .env.behat.example .env.behat      (macOS/Linux: cp)
#   php artisan key:generate --env=behat
#
# PENTING: DB_DATABASE harus database khusus test yang namanya diakhiri "_testing".
# Isinya DIHAPUS dan diisi ulang seeder sebelum setiap skenario.

# "BEHAT" di nama aplikasi dipakai FeatureContext untuk memastikan server
# yang diuji benar-benar memakai file ini, bukan .env biasa.
APP_NAME="LokerLens BEHAT"
APP_ENV=behat
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lokerlens_testing
DB_USERNAME=root
DB_PASSWORD=

# Session & cache di file supaya tidak ikut terhapus saat database di-reset
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

LOKERLENS_AMBANG_PRIORITAS=70
DEV_PREVIEW=false

# API ML hanya dipanggil skenario @ml. 127.0.0.1 (bukan localhost) agar tidak ada jeda di Windows.
ML_API_URL=http://127.0.0.1:8001
ML_API_TIMEOUT=4
