# Contoh environment SERVER PRODUKSI (Coolify + Docker). Panduan: README.md bagian "Deploy".
# Isi nilai-nilai ini di menu Environment Variables Coolify, JANGAN commit file berisi rahasia asli.
# Nilai bertanda <...> wajib diganti.

APP_NAME=LokerLens
APP_ENV=production
APP_DEBUG=false
# Buat sekali di laptop: php artisan key:generate --show   (lalu salin hasilnya ke sini)
APP_KEY=<base64:...>
# Alamat publik dengan https (sama dengan domain di Coolify)
APP_URL=<https://lokerlens.contoh.go.id>

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Aplikasi berjalan di belakang proxy Coolify (Traefik): percayai header X-Forwarded-*
# supaya link dan form memakai https.
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database MySQL. Di docker-compose.yml nama host-nya "db".
# Jika memakai database terpisah dari Coolify, isi host dan akunnya dari halaman database tersebut.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lokerlens
DB_USERNAME=lokerlens
DB_PASSWORD=<kata-sandi-database-yang-kuat>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email (Lupa Password)
# Jika server SMTP belum ada, biarkan MAIL_MAILER=log: aplikasi tetap jalan, tetapi email
# atur ulang kata sandi TIDAK terkirim (hanya tercatat di log container).
MAIL_MAILER=log
# Jika SMTP sudah ada, ganti menjadi:
# MAIL_MAILER=smtp
# MAIL_HOST=<smtp.contoh.go.id>
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=<akun-smtp>
# MAIL_PASSWORD=<kata-sandi-smtp>
MAIL_FROM_ADDRESS=<noreply@contoh.go.id>
MAIL_FROM_NAME="${APP_NAME}"

# Ambang prioritas tinggi (sama dengan ml/models/model_lokerlens_meta.json)
LOKERLENS_AMBANG_PRIORITAS=70

# Mode /dev wajib mati di server
DEV_PREVIEW=false

# API ML di jaringan internal Docker (nama service "ml" di docker-compose.yml). Port 8001 tidak dibuka ke internet.
ML_API_URL=http://ml:8001
ML_API_TIMEOUT=4
